<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wb_racking_report_wizard_form" model="ir.ui.view">
        <field name="name">wb.racking.report.wizard.form</field>
        <field name="model">wb.racking.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Rackeo Excel (STOR)">
                <sheet>
                    <group>
                        <field name="purchase_id" readonly="1"/>
                        <field name="file_name" invisible="1"/>
                        <field name="report_file" filename="file_name" readonly="1" widget="binary" invisible="not report_file"/>
                    </group>
                    <p class="text-muted" invisible="report_file">
                        Haz clic en <b>Generar Reporte Excel</b> para analizar los movimientos de rackeo (STOR) y descargar el archivo desglosado por SKU.
                    </p>
                </sheet>
                <footer>
                    <button name="action_generate_excel_report" string="Generar Reporte Excel" type="object" class="btn-primary" invisible="report_file"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
