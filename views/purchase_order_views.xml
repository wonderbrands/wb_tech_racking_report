<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_wb_racking_report" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.wb.racking.report</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_racking_report_wizard" 
                        string="Reporte Rackeo Excel" 
                        type="object" 
                        class="btn-secondary" 
                        icon="fa-file-excel-o"/>
            </xpath>
        </field>
    </record>
</odoo>
